# =========================================================================== #
#  XAU Dynamics · TickForge — example environment
#  Copy to `.env` for local development:  cp .env.example .env
#
#  `.env` is git-ignored and docker-ignored. NEVER put a real credential in
#  this file — it is committed. In Azure, inject secrets as Container Apps
#  secret references backed by Key Vault, or eliminate them entirely with a
#  managed identity (AZURE_COSMOS_AUTH_MODE=aad).
#
#  Every value below is the built-in default unless marked otherwise, so an
#  empty .env behaves identically to no .env at all. Print the resolved,
#  redacted configuration with:  python config.py
# =========================================================================== #

# --- Environment ----------------------------------------------------------- #
# development | staging | production
# `production` refuses FEED_MODE=simulated and PIPELINE_SINK_MODE=stdout.
TICKFORGE_ENV=development
# Escape hatch for the production guard rails. Keep false.
ALLOW_UNSAFE_PRODUCTION=false

# --- Market data feed ------------------------------------------------------ #
# live      -> connects to GOLD_FEED_URL over WebSocket
# simulated -> deterministic synthetic ticks (load harness only)
FEED_MODE=simulated
GOLD_FEED_URL=wss://stream-api.xau-dynamics.io/v3/gold
FEED_SYMBOL=XAUUSD
# SECRET — sent as `Authorization: Bearer <value>`. Leave blank locally.
# Rejected at startup if it contains mock/placeholder/changeme/etc.
FEED_API_KEY=
FEED_PING_INTERVAL_SECONDS=20
FEED_PING_TIMEOUT_SECONDS=20
FEED_OPEN_TIMEOUT_SECONDS=10
# Silence longer than this forces a reconnect: a TCP socket can stay open
# while the venue has stopped publishing.
FEED_RECV_TIMEOUT_SECONDS=30
# Upper bound on the WebSocket closing handshake. The connection is dropped
# outright on shutdown rather than negotiated: every tick is already persisted,
# and a venue that keeps streaming can otherwise hold the handshake open long
# enough for the platform to SIGKILL us mid-flush.
FEED_CLOSE_TIMEOUT_SECONDS=5
FEED_MAX_MESSAGE_BYTES=1048576
FEED_RECONNECT_INITIAL_SECONDS=1.0
FEED_RECONNECT_MAX_SECONDS=60
FEED_RECONNECT_JITTER=0.25
# Legacy alias, honoured as the default for FEED_RECONNECT_INITIAL_SECONDS.
# RETRY_DELAY_SECONDS=1.0

# --- Simulator (FEED_MODE=simulated only) ---------------------------------- #
SIM_BASE_PRICE=2350.00
SIM_TICK_INTERVAL_SECONDS=0.1
SIM_PRICE_STEP=0.75
SIM_HALF_SPREAD=0.15
SIM_MIN_VOLUME=10
SIM_MAX_VOLUME=150
# Set for reproducible runs; unset for a fresh random walk each start.
# SIM_SEED=42

# --- Persistence ----------------------------------------------------------- #
# cosmos -> Azure Cosmos DB (production)
# stdout -> NDJSON to stdout (local development and CI)
PIPELINE_SINK_MODE=cosmos
AZURE_COSMOS_URI=https://xau-dynamics-db.documents.azure.com:443/
# aad -> managed identity via DefaultAzureCredential (recommended, keyless)
# key -> account key, required only when no identity is available
AZURE_COSMOS_AUTH_MODE=aad
# SECRET — required only when AZURE_COSMOS_AUTH_MODE=key. Leave blank.
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=XAUDynamicsDB
AZURE_COSMOS_TICKS_CONTAINER=MarketTicks
AZURE_COSMOS_CONTEXT_CONTAINER=MarketContext
AZURE_COSMOS_BARS_CONTAINER=MarketBars
# Synthetic key `{symbol}-{YYYYMMDDHH}` keeps each logical partition well
# under the 20 GB ceiling and spreads write throughput across hours.
AZURE_COSMOS_PARTITION_KEY_PATH=/pk
# Per-item TTL in seconds; -1 disables expiry. 7d / 30d / 90d.
AZURE_COSMOS_TICK_TTL_SECONDS=604800
AZURE_COSMOS_CONTEXT_TTL_SECONDS=2592000
AZURE_COSMOS_BAR_TTL_SECONDS=7776000
AZURE_COSMOS_MAX_CONCURRENT_WRITES=32
AZURE_COSMOS_CONNECTION_TIMEOUT_SECONDS=10
AZURE_COSMOS_RETRY_TOTAL=9
# Container creation is a CONTROL-PLANE operation that the built-in
# "Cosmos DB Built-in Data Contributor" role cannot perform. Provision with
# Bicep and leave this false in every deployed environment.
AZURE_COSMOS_PROVISION_ON_START=false
# Comma-separated read regions, nearest first.
# AZURE_COSMOS_PREFERRED_LOCATIONS=West Europe,North Europe

# --- Pipeline -------------------------------------------------------------- #
# One writer per instrument shard. Two replicas with the same shard id would
# persist every tick twice and corrupt realised volatility. Shard by symbol,
# never by raising --max-replicas.
PIPELINE_SHARD_ID=shard-0
# The bounded queue is the backpressure boundary of the whole service.
PIPELINE_QUEUE_MAXSIZE=1000
# block       -> producer waits (lossless, applies backpressure to the feed)
# drop_oldest -> discard the stalest tick (bounded latency, lossy)
PIPELINE_QUEUE_FULL_POLICY=block
# A batch flushes on whichever comes first: record count or age.
PIPELINE_BATCH_MAX_RECORDS=50
PIPELINE_BATCH_MAX_SECONDS=2.0
# Must stay below the Container Apps termination grace period (default 30s).
PIPELINE_SHUTDOWN_GRACE_SECONDS=20
# 0 = run forever. Set a positive value for bounded smoke tests.
PIPELINE_RUN_DURATION_SECONDS=0
# Vectorised numpy context per batch: log-return stdev, realised vol, p95 spread.
PIPELINE_ENABLE_MARKET_CONTEXT=true
# pandas OHLCV resampling. Set false to drop pandas from the image entirely.
PIPELINE_ENABLE_BAR_AGGREGATION=true
PIPELINE_BAR_INTERVAL=1s
PIPELINE_BAR_FLUSH_SECONDS=5

# --- Observability --------------------------------------------------------- #
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json -> one object per line for Log Analytics; text -> human-readable
LOG_FORMAT=json
# WARNING: the health endpoint is UNAUTHENTICATED by design, like any probe.
# Keep Container Apps ingress internal, or disable ingress and use a TCP probe.
HEALTH_ENABLED=true
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
# Readiness fails once the feed has been silent this long.
HEALTH_MAX_TICK_AGE_SECONDS=60
METRICS_INTERVAL_SECONDS=30

# --- Advanced -------------------------------------------------------------- #
# Load a different dotenv file. Real environment variables always win.
# TICKFORGE_ENV_FILE=.env.local
